# Single .env at project root — used by both Django and Next.js

# AI — used by Next.js /api/stream/ route handler
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Database — used by Django
DB_NAME=screeniq
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
